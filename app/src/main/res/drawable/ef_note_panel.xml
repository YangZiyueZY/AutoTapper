<?xml version="1.0" encoding="utf-8"?>
<!-- 提示块：白底细框，左侧一面强调色竖条（提示用黄旗，不用红） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ef_panel" />
            <stroke
                android:width="1dp"
                android:color="@color/ef_rule" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item
        android:width="4dp"
        android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="@color/ef_signal" />
        </shape>
    </item>
</layer-list>
