<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      大屏 / 平板横屏档（可用宽度 >= 840dp）：左右两栏并排。
      与 values-w600dp 同为 w<N>dp 限定符，840 比 600 更贴近实际宽度，因此本档优先命中。
    -->
    <dimen name="page_gutter">48dp</dimen>
    <dimen name="section_gap">40dp</dimen>
    <dimen name="block_gap">24dp</dimen>
    <dimen name="block_padding">24dp</dimen>
    <dimen name="control_min_height">56dp</dimen>
    <dimen name="permission_row_min_height">56dp</dimen>
    <dimen name="list_row_height">64dp</dimen>
    <dimen name="body_size">16sp</dimen>
    <dimen name="label_size">14sp</dimen>
    <dimen name="title_size">34sp</dimen>
    <dimen name="section_title_size">18sp</dimen>
    <!-- 两栏之间的沟槽；每栏宽度由可用宽度与 gutter / gap 共同决定，不再额外限宽 -->
    <dimen name="column_gap">48dp</dimen>
    <dimen name="content_max_width">10000dp</dimen>
    <dimen name="command_bar_height">64dp</dimen>
    <dimen name="command_bar_padding_start">40dp</dimen>
    <dimen name="command_bar_padding_end">12dp</dimen>
</resources>
