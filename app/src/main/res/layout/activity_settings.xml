<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（页面类型：控制台）。
    命令栏（深色，// SETTINGS 眉标 + 中文标题「设置」）
    三色条（3dp，全宽，只出现在页顶；与主界面同一做法）
    内容区（FrameLayout）
      ├ ImageView contour：右上角 140×100dp，画在最底层当背景质感，不压内容
      └ ScrollView → settings_container：六个分节由 Activity 逐个 new Ef 部件生成

  Ef* 自定义部件（EfSegmented / EfFieldRow / EfBlock / EfNotice）没有
  (Context, AttributeSet) 构造函数，不能在 XML 里 inflate：这里只留一个占位容器
  settings_container，实例全部在 SettingsActivity 里建。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ef_paper"
    android:orientation="vertical">

    <!-- 1. 深色命令栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ef_command_bar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/command_bar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/command_bar_padding_start"
            android:paddingEnd="@dimen/command_bar_padding_end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.AutoTapper.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_eyebrow"
                    android:textColor="@color/ef_command_bar_text" />

                <TextView
                    style="@style/Text.AutoTapper.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/set_title"
                    android:textColor="@color/ef_command_bar_text" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 命令栏底部：一小段黄块标出当前分区 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp">

            <View
                android:layout_width="@dimen/strip_segment_width"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/ef_signal" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2. 三色条：全宽 3dp，三段等分，只出现在页顶 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_a" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_b" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_c" />
    </LinearLayout>

    <!-- 3. 内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="100dp"
            android:layout_gravity="top|end"
            android:alpha="0.9"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd"
            android:src="@drawable/contour_a" />

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="@dimen/block_gap"
                android:paddingEnd="@dimen/page_gutter"
                android:paddingBottom="@dimen/section_gap" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
