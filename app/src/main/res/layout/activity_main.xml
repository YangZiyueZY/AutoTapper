<?xml version="1.0" encoding="utf-8"?>
<!--
  终末地风味主界面（页面类型：控制台 —— 深色命令栏 + 大看板 + 干活用的列表和表单）。
  固定规则：圆角 0；切角只给能按的块（按钮，切右下角 8dp）；1px ef_rule 细线分区；
  强调色 ef_signal 只做“当前位置 / 可操作 / 需要注意”的填充，上面的字用 ef_on_signal；红色只给删除。
  英文小标签：Saira 宽体、全大写、字距 0.14em；中文：系统黑体粗体；数字：等宽数字 tnum。

  响应式结构（详见 MainActivity.applyResponsiveLayout）：
    命令栏 + 三色条（全宽，不参与响应式）
      └ ScrollView
          └ FrameLayout content_frame（content_root 的居中容器）
              └ LinearLayout content_root（水平 padding = @dimen/page_gutter，宽度上限 = @dimen/content_max_width）
                  └ LinearLayout content_split（手机/平板竖屏 vertical，>=840dp 时由代码切成 horizontal）
                      ├ content_left ：view_hero / view_permissions / view_tap_mode
                      └ content_right：view_points / view_settings / view_summary / view_note
    单列时渲染顺序 = 左栏全部 + 右栏全部，与改造前的单列顺序逐段一致；
    每段的分区细线只写在后一段的开头（view_summary 用留白 + 眉标分隔），所以拼起来不会出现双线。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ef_paper"
    android:orientation="vertical">

    <!-- 1. 深色命令栏：两套主题都是深色，底部一小段黄块标出当前分区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ef_command_bar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/command_bar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/command_bar_padding_start"
            android:paddingEnd="@dimen/command_bar_padding_end">

            <TextView
                style="@style/Text.AutoTapper.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eyebrow_brand"
                android:textColor="@color/ef_command_bar_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_version"
                style="@style/Text.AutoTapper.Field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ef_command_bar_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_check_update"
                style="@style/Button.AutoTapper.Command"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/control_min_height"
                android:layout_marginStart="8dp"
                android:text="@string/check_update" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp">

            <View
                android:layout_width="@dimen/strip_segment_width"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/ef_signal" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2. 三色条：全宽 3dp，三段等分，只出现在页顶 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_a" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_b" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_c" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <!-- content_frame 只负责把 content_root 水平居中（宽度上限由代码设置） -->
        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/content_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="@dimen/section_gap"
                android:paddingEnd="@dimen/page_gutter"
                android:paddingBottom="@dimen/section_gap">

                <LinearLayout
                    android:id="@+id/content_split"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 左栏：说明 hero + 权限状态 + 点击方式 -->
                    <LinearLayout
                        android:id="@+id/content_left"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/view_hero" />

                        <include layout="@layout/view_permissions" />

                        <include layout="@layout/view_tap_mode" />
                    </LinearLayout>

                    <!-- 右栏：点击点位 + 点击配置 + 当前配置 + 使用说明 -->
                    <LinearLayout
                        android:id="@+id/content_right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/view_points" />

                        <include layout="@layout/view_settings" />

                        <include layout="@layout/view_summary" />

                        <include layout="@layout/view_note" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
