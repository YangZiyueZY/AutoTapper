<?xml version="1.0" encoding="utf-8"?>
<!--
  日志页（页面类型：控制台）。
    命令栏（深色，// LOGS 眉标 + 中文标题「日志」+ 导出 / 清空）
    三色条（3dp，全宽，只出现在页顶；与主界面同一做法）
    内容区（LinearLayout 竖排）
      ├ 分段筛选（EfSegmented，代码建）+ 右上「清空」同一行
      ├ 关键字过滤输入框（EditText）
      ├ 暂停自动滚动提示（EfNotice，默认 GONE）
      └ 列表（RecyclerView）/ 空状态（EfHatch，代码建）二选一

  Ef* 自定义部件没有 (Context, AttributeSet) 构造函数，不能在 XML 里 inflate：
  这里只留占位容器（seg_holder / paused_holder / hatch_holder），实例在 Activity 里建。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ef_paper"
    android:orientation="vertical">

    <!-- 1. 深色命令栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ef_command_bar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/command_bar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/command_bar_padding_start"
            android:paddingEnd="@dimen/command_bar_padding_end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_logs_eyebrow"
                    style="@style/Text.AutoTapper.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/logs_eyebrow"
                    android:textColor="@color/ef_command_bar_text" />

                <TextView
                    android:id="@+id/tv_logs_title"
                    style="@style/Text.AutoTapper.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/logs_title"
                    android:textColor="@color/ef_command_bar_text" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 导出：墨底切角块，按下擦黄（底色由 Activity 用 EfShapeDrawable 设置） -->
            <TextView
                android:id="@+id/btn_export"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/control_min_height"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="72dp"
                android:paddingStart="12dp"
                android:paddingEnd="20dp"
                android:text="@string/logs_action_export"
                android:textColor="@color/ef_command_bar_text"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp">

            <View
                android:layout_width="@dimen/strip_segment_width"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/ef_signal" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2. 三色条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_a" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_b" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_c" />
    </LinearLayout>

    <!-- 3. 内容区（平板档会由 EfPageWidth 收窄并居中） -->
    <LinearLayout
        android:id="@+id/logs_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 分段筛选 + 右上清空：同一行，分段占权重，清空固定宽度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/block_gap"
            android:paddingEnd="@dimen/page_gutter">

            <!-- 五个分段（全部/INFO/WARN/ERROR/RESULT）在 1080dp 手机上放不下一行，
                 之前被父容器裁掉最后一个，所以这里改成可横滑：段落各自保持自然宽度。 -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/seg_holder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/btn_clear"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/control_min_height"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="64dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/logs_action_clear"
                android:textColor="@color/ef_ink"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 关键字过滤：直角输入框 + 细线 -->
        <EditText
            android:id="@+id/et_search"
            style="@style/Input.AutoTapper.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="@dimen/block_gap"
            android:layout_marginEnd="@dimen/page_gutter"
            android:hint="@string/logs_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true" />

        <!-- 暂停自动滚动提示：默认 GONE，上滑超过 2 屏时出现 -->
        <LinearLayout
            android:id="@+id/paused_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/block_gap"
            android:paddingEnd="@dimen/page_gutter"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_logs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="@dimen/block_gap"
                android:paddingEnd="@dimen/page_gutter"
                android:paddingBottom="@dimen/section_gap"
                android:scrollbars="none" />

            <FrameLayout
                android:id="@+id/hatch_holder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/page_gutter"
                android:layout_marginTop="@dimen/block_gap"
                android:layout_marginEnd="@dimen/page_gutter"
                android:layout_marginBottom="@dimen/section_gap"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>