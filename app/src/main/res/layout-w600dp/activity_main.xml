<?xml version="1.0" encoding="utf-8"?>
<!--
  终末地风味主界面（页面类型：控制台 —— 深色命令栏 + 大看板 + 干活用的列表和表单）。
  固定规则：圆角 0；切角只给能按的块（按钮，切右下角 8dp）；1px ef_rule 细线分区；
  强调色 ef_signal 只做“当前位置 / 可操作 / 需要注意”的填充，上面的字用 ef_on_signal；红色只给删除。
  英文小标签：Saira 宽体、全大写、字距 0.14em；中文：系统黑体粗体；数字：等宽数字 tnum。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ef_paper"
    android:orientation="vertical">

    <!-- 1. 深色命令栏：两套主题都是深色，底部一小段黄块标出当前分区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ef_command_bar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="8dp">

            <TextView
                style="@style/Text.AutoTapper.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eyebrow_brand"
                android:textColor="@color/ef_command_bar_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_version"
                style="@style/Text.AutoTapper.Field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ef_command_bar_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_check_update"
                style="@style/Button.AutoTapper.Command"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/check_update" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp">

            <View
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/ef_signal" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2. 三色条：全宽 3dp，三段等分，只出现在页顶 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_a" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_b" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/ef_tri_c" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <!-- 3. 首屏：中文大标题 + 一句说明 + 一行字段（宽体小字，代码填文案） -->
            <TextView
                style="@style/Text.AutoTapper.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/screen_title" />

            <TextView
                style="@style/Text.AutoTapper.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:text="@string/screen_subtitle"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_hero_fields"
                style="@style/Text.AutoTapper.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="36dp"
                android:background="@color/ef_rule" />

            <!-- 4. 权限状态 -->
            <TextView
                style="@style/Text.AutoTapper.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eyebrow_permissions" />

            <TextView
                style="@style/Text.AutoTapper.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/status_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Text.AutoTapper.Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No.01" />
                    <!-- 兼容旧 id：老代码会在这个小方块上设置背景，尺寸为 0，不占位也不显示 -->
                    <View
                        android:id="@+id/dot_overlay"
                        android:layout_width="0dp"
                        android:layout_height="0dp" />

                    <!-- 名称在上、状态块在下：状态文案由代码设置，可能比行内空间宽，竖排更稳 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="悬浮窗权限"
                            android:textColor="@color/ef_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_overlay_state"
                            style="@style/Text.AutoTapper.StateBlock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grant_overlay"
                        style="@style/Button.AutoTapper.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/grant_permission_button" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ef_rule" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Text.AutoTapper.Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No.02" />
                    <!-- 兼容旧 id：老代码会在这个小方块上设置背景，尺寸为 0，不占位也不显示 -->
                    <View
                        android:id="@+id/dot_accessibility"
                        android:layout_width="0dp"
                        android:layout_height="0dp" />

                    <!-- 名称在上、状态块在下：状态文案由代码设置，可能比行内空间宽，竖排更稳 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="无障碍服务"
                            android:textColor="@color/ef_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_accessibility_state"
                            style="@style/Text.AutoTapper.StateBlock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grant_accessibility"
                        style="@style/Button.AutoTapper.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/grant_permission_button" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ef_rule" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Text.AutoTapper.Tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No.03" />

                    <!-- 名称在上、状态块在下：状态文案由代码设置，可能比行内空间宽，竖排更稳 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Shizuku"
                            android:textColor="@color/ef_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_shizuku_state"
                            style="@style/Text.AutoTapper.StateBlock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grant_shizuku"
                        style="@style/Button.AutoTapper.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/grant_permission_button" />
                </LinearLayout>

            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="36dp"
                android:background="@color/ef_rule" />

            <!-- 5. 点击方式：分段选择，当前段墨底反白（不用黄） -->
            <TextView
                style="@style/Text.AutoTapper.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eyebrow_tap_mode" />

            <TextView
                style="@style/Text.AutoTapper.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tap_mode_title" />

            <TextView
                style="@style/Text.AutoTapper.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:text="@string/tap_mode_intro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_auto"
                    style="@style/Button.AutoTapper.Segment"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/tap_mode_auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_shizuku"
                    style="@style/Button.AutoTapper.Segment"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/tap_mode_shizuku" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_tap_mode_hint"
                style="@style/Text.AutoTapper.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="36dp"
                android:background="@color/ef_rule" />

            <!-- 6. 点击点位 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.AutoTapper.Eyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/eyebrow_points" />

                    <TextView
                        style="@style/Text.AutoTapper.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/points_title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_points_count"
                    style="@style/Text.AutoTapper.Tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tv_points_empty"
                style="@style/Text.AutoTapper.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/points_empty"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_controller"
                style="@style/Button.AutoTapper.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/open_controller" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="36dp"
                android:background="@color/ef_rule" />

            <!-- 7. 点击配置 -->
            <TextView
                style="@style/Text.AutoTapper.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eyebrow_settings" />

            <TextView
                style="@style/Text.AutoTapper.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/config_title" />

            <TextView
                style="@style/Text.AutoTapper.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:text="@string/config_intro" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.AutoTapper.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/et_interval_ms"
                        android:text="@string/interval_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_interval_ms"
                            style="@style/Input.AutoTapper.Field"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:importantForAutofill="no" />

                        <TextView
                            style="@style/Text.AutoTapper.Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="ms" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.AutoTapper.Help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/interval_help" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.AutoTapper.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/et_random_extra_ms"
                        android:text="@string/random_extra_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_random_extra_ms"
                            style="@style/Input.AutoTapper.Field"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:importantForAutofill="no" />

                        <TextView
                            style="@style/Text.AutoTapper.Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="ms" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.AutoTapper.Help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/random_extra_help" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.AutoTapper.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/et_tap_duration_ms"
                        android:text="@string/tap_duration_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_tap_duration_ms"
                            style="@style/Input.AutoTapper.Field"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:importantForAutofill="no" />

                        <TextView
                            style="@style/Text.AutoTapper.Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="ms" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.AutoTapper.Help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/tap_duration_help" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.AutoTapper.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/et_repeat_count"
                        android:text="@string/repeat_count_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_repeat_count"
                            style="@style/Input.AutoTapper.Field"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:importantForAutofill="no" />

                        <TextView
                            style="@style/Text.AutoTapper.Unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="轮" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.AutoTapper.Help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/repeat_count_help" />
                </LinearLayout>

            <!-- 悬浮窗透明度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.AutoTapper.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/controller_alpha_label" />

                    <TextView
                        android:id="@+id/tv_controller_alpha_value"
                        style="@style/Text.AutoTapper.Field"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ef_ink" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_controller_alpha"
                    style="@style/Slider.AutoTapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.3"
                    android:valueTo="1.0" />
            </LinearLayout>

            <!-- 配置摘要：一块看板（白板 + 1px 墨线 + 顶部墨色页签） -->
            <TextView
                style="@style/Text.AutoTapper.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/eyebrow_summary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/ef_panel_board"
                android:orientation="vertical">

                <View
                    android:layout_width="120dp"
                    android:layout_height="5dp"
                    android:background="@color/ef_ink" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.AutoTapper.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config_summary_title" />

                    <TextView
                        android:id="@+id/tv_config_summary"
                        style="@style/Text.AutoTapper.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="36dp"
                android:background="@color/ef_rule" />

            <!-- 8. 使用说明：白底细框 + 左侧强调色竖条 -->
            <TextView
                style="@style/Text.AutoTapper.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
