    <!-- 点击配置 -->
    <string name="config_title">点击配置</string>
    <string name="config_intro">按点位顺序轮流点击。实际等待 = 基础间隔 + 0 到随机附加延迟之间的随机值；点击时长决定每次按下到抬起持续多久。</string>
    <string name="interval_label">基础间隔</string>
    <string name="interval_help">单位毫秒，每次点击之间至少等待多久。默认 100，建议 100 到 300。</string>
    <string name="random_extra_label">随机附加延迟</string>
    <string name="random_extra_help">单位毫秒，在基础间隔上额外随机增加 0 到该值。填 0 表示固定节奏。</string>
    <string name="tap_duration_label">点击时长</string>
    <string name="tap_duration_help">单位毫秒，按下到抬起持续的时间。默认 50，取值 10 到 2000；太短可能被部分应用忽略。</string>
    <string name="repeat_count_label">点击轮数</string>
    <string name="repeat_count_help">每轮按顺序把每个点位各点一次。1 = 各点 1 次，10 = 跑 10 轮，0 = 一直点击到手动停止。</string>
    <string name="controller_alpha_label">悬浮窗透明度</string>
    <string name="controller_alpha_value">%1$.0f%%</string>
    <string name="config_summary_title">当前配置</string>
    <string name="config_summary_template">多点轮询 · %1$d 个点位\n每次点击后等待：%2$d-%3$d 毫秒\n单次点击时长：%4$d 毫秒\n点击轮数：%5$s</string>
    <string name="config_summary_repeat_infinite">无限（直到手动停止）</string>
    <string name="config_summary_repeat_finite">%1$d 轮</string>
    <string name="config_summary_invalid">请输入有效配置：基础间隔至少 100 毫秒，点击时长需在 10 到 2000 毫秒之间，各字段都不能留空。</string>
    <string name="interval_adjusted_note">基础间隔低于 100 毫秒，开始时会按 100 毫秒处理。</string>
    <string name="tap_duration_adjusted_note">点击时长超出 10 到 2000 毫秒，开始时会按最近的边界值处理。</string>

