<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      终末地风味主题（endfield-ui）：纸面 + 墨色，只有一种强调色 ef_signal（黄）。
      黄只表示“当前位置 / 可操作 / 需要注意”，只做填充，上面的字用 ef_on_signal；
      红色 ef_danger 只给删除；圆角一律为 0（shapeAppearance* 全部 cut + 0dp）；
      不用投影、发光、涟漪（colorControlHighlight 透明）。
      颜色都取自 ef_* 颜色资源，values/ 与 values-night/ 各有一套，主题本身不写死色值。
    -->
    <style name="Theme.AutoTapper" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- 主色是墨不是黄：Material 默认部件（光标、焦点线、进度条）用主色画线，
             黄线在浅色纸上看不见，所以主色给墨，黄只留给 ef 部件自己填。 -->
        <item name="colorPrimary">@color/ef_ink</item>
        <item name="colorOnPrimary">@color/ef_paper</item>
        <item name="colorPrimaryContainer">@color/ef_chip</item>
        <item name="colorOnPrimaryContainer">@color/ef_ink</item>
        <item name="colorPrimaryVariant">@color/ef_ink</item>

        <item name="colorSecondary">@color/ef_signal</item>
        <item name="colorOnSecondary">@color/ef_on_signal</item>
        <item name="colorSecondaryContainer">@color/ef_chip</item>
        <item name="colorOnSecondaryContainer">@color/ef_ink</item>
        <item name="colorSecondaryVariant">@color/ef_signal</item>

        <item name="colorTertiary">@color/ef_ink</item>
        <item name="colorOnTertiary">@color/ef_paper</item>
        <item name="colorTertiaryContainer">@color/ef_chip</item>
        <item name="colorOnTertiaryContainer">@color/ef_ink</item>

        <item name="colorError">@color/ef_danger</item>
        <item name="colorOnError">@color/ef_panel</item>
        <item name="colorErrorContainer">@color/ef_chip</item>
        <item name="colorOnErrorContainer">@color/ef_ink</item>

        <item name="android:colorBackground">@color/ef_paper</item>
        <item name="colorOnBackground">@color/ef_ink</item>
        <item name="colorSurface">@color/ef_panel</item>
        <item name="colorOnSurface">@color/ef_ink</item>
        <item name="colorSurfaceVariant">@color/ef_chip</item>
        <item name="colorOnSurfaceVariant">@color/ef_ink2</item>

        <!-- 容器色全落到 板 / 安静填充 两档，避免 Material 默认的紫灰调 -->
        <item name="colorSurfaceContainerLowest">@color/ef_panel</item>
        <item name="colorSurfaceContainerLow">@color/ef_panel</item>
        <item name="colorSurfaceContainer">@color/ef_chip</item>
        <item name="colorSurfaceContainerHigh">@color/ef_chip</item>
        <item name="colorSurfaceContainerHighest">@color/ef_chip</item>

        <item name="colorOutline">@color/ef_rule</item>
        <item name="colorOutlineVariant">@color/ef_rule</item>

        <!-- 不用 Material 涟漪：按下靠 ColorStateList 换底色 -->
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="colorControlActivated">@color/ef_ink</item>
        <item name="colorControlNormal">@color/ef_ink2</item>

        <!-- 系统栏：命令栏两套主题都是深色，状态栏跟着它 -->
        <item name="android:statusBarColor">@color/ef_command_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/ef_paper</item>

        <!-- 形状：一律直角 -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AutoTapper.Square</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AutoTapper.Square</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AutoTapper.Square</item>

        <!-- 对话框：Material3 默认 28dp 大圆角，和"圆角一律 0"冲突，这里整套压平 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AutoTapper.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AutoTapper.Dialog</item>
    </style>

    <!--
      对话框主题：只做两件事——把圆角压成 0、把容器色落到 ef_panel。
      M3 对话框的形状由 shapeAppearanceCorner* 五个档位决定，只改一个档位会剩下一圈圆角，
      所以五个档位全部指向同一个直角形状。
    -->
    <style name="ThemeOverlay.AutoTapper.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/ef_panel</item>
        <item name="colorOnSurface">@color/ef_ink</item>
        <item name="colorPrimary">@color/ef_ink</item>
        <item name="colorOnPrimary">@color/ef_paper</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AutoTapper.Square</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.AutoTapper.Square</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.AutoTapper.Square</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.AutoTapper.Square</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.AutoTapper.Square</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.AutoTapper.Square</item>
    </style>

    <!--
      取点浮层（OverlayService 用 ThemeOverlay 包一层再 inflate overlay_layout）。
      浮层不在 Activity 里，必须自己把颜色、形状补齐，Material 部件才能正常膨胀。
    -->
    <style name="ThemeOverlay.AutoTapper.Floating" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/ef_ink</item>
        <item name="colorOnPrimary">@color/ef_paper</item>
        <item name="colorPrimaryContainer">@color/ef_chip</item>
        <item name="colorOnPrimaryContainer">@color/ef_ink</item>
        <item name="colorPrimaryVariant">@color/ef_ink</item>

        <item name="colorSecondary">@color/ef_signal</item>
        <item name="colorOnSecondary">@color/ef_on_signal</item>
        <item name="colorSecondaryContainer">@color/ef_chip</item>
        <item name="colorOnSecondaryContainer">@color/ef_ink</item>
        <item name="colorSecondaryVariant">@color/ef_signal</item>

        <item name="colorError">@color/ef_danger</item>
        <item name="colorOnError">@color/ef_panel</item>

        <item name="android:colorBackground">@color/ef_paper</item>
        <item name="colorOnBackground">@color/ef_ink</item>
        <item name="colorSurface">@color/ef_panel</item>
        <item name="colorOnSurface">@color/ef_ink</item>
        <item name="colorSurfaceVariant">@color/ef_chip</item>
        <item name="colorOnSurfaceVariant">@color/ef_ink2</item>
        <item name="colorSurfaceContainer">@color/ef_chip</item>
        <item name="colorSurfaceContainerHigh">@color/ef_chip</item>
        <item name="colorSurfaceContainerHighest">@color/ef_chip</item>
        <item name="colorOutline">@color/ef_rule</item>
        <item name="colorOutlineVariant">@color/ef_rule</item>

        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="colorControlActivated">@color/ef_ink</item>
        <item name="colorControlNormal">@color/ef_ink2</item>
        <item name="elevationOverlayEnabled">false</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AutoTapper.Square</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AutoTapper.Square</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AutoTapper.Square</item>
    </style>

</resources>