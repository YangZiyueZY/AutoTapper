<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      终末地风味：圆角一律 0，卡片不用投影。尺寸名沿用旧名，值改成风格允许的尺寸，
      这样既有代码里 R.dimen.* 的引用不会断。
    -->
    <dimen name="card_corner_radius">0dp</dimen>
    <dimen name="card_corner_radius_large">0dp</dimen>
    <dimen name="card_elevation">0dp</dimen>
    <dimen name="card_spacing">16dp</dimen>
    <dimen name="card_padding">16dp</dimen>

    <!-- 触控区：不小于 48dp -->
    <dimen name="button_height">48dp</dimen>
    <dimen name="icon_button_size">48dp</dimen>
    <dimen name="icon_button_padding">12dp</dimen>
    <dimen name="fab_handle_size">48dp</dimen>

    <!-- 浮层 -->
    <dimen name="overlay_corner_radius">0dp</dimen>
    <dimen name="overlay_padding">8dp</dimen>
    <dimen name="overlay_button_padding">8dp</dimen>
    <dimen name="overlay_min_width">280dp</dimen>
    <dimen name="overlay_max_width">340dp</dimen>
    <dimen name="overlay_elevation">0dp</dimen>

    <dimen name="status_dot_size">10dp</dimen>

    <!-- 区块尺寸 -->
    <dimen name="command_bar_height">56dp</dimen>
    <dimen name="strip_height">3dp</dimen>
    <dimen name="strip_segment_width">64dp</dimen>
    <dimen name="board_tab_width">120dp</dimen>
    <dimen name="board_tab_height">5dp</dimen>
    <dimen name="note_bar_width">4dp</dimen>
    <dimen name="tag_padding_h">8dp</dimen>
    <dimen name="tag_padding_v">3dp</dimen>
    <dimen name="page_padding_h">16dp</dimen>

    <!--
      响应式布局（手机档）。这些值必须等于改造前 activity_main.xml 里的硬编码值，
      sw < 600dp 的手机才会与改造前逐像素一致；平板/大屏的覆盖值在 values-sw600dp 与 values-w840dp。
      dimen 只能表达尺寸（dp/sp）：match_parent、权重、是否两栏由 MainActivity.applyResponsiveLayout() 处理。
    -->
    <dimen name="page_gutter">16dp</dimen>
    <dimen name="section_gap">24dp</dimen>
    <dimen name="block_gap">16dp</dimen>
    <dimen name="block_padding">16dp</dimen>
    <dimen name="control_min_height">48dp</dimen>
    <dimen name="permission_row_min_height">52dp</dimen>
    <dimen name="list_row_height">52dp</dimen>
    <dimen name="body_size">15sp</dimen>
    <dimen name="label_size">13sp</dimen>
    <dimen name="title_size">30sp</dimen>
    <dimen name="section_title_size">17sp</dimen>
    <dimen name="column_gap">0dp</dimen>
    <dimen name="content_max_width">10000dp</dimen>
    <dimen name="command_bar_padding_start">16dp</dimen>
    <dimen name="command_bar_padding_end">8dp</dimen>
</resources>
